# Aplicação
PORT=3000

# PostgreSQL - usado pela aplicação e pelo serviço db do compose
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flags

# Credenciais do container postgres (compose.yaml / compose.prod.yaml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flags

# Adminer (profile tools)
ADMINER_PORT=8081
